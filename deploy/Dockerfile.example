# Multi-stage Dockerfile example for building the frontend and serving static files
# Sets NPM_CONFIG_PRODUCTION=false so devDependencies (like Vite) are available during build

# Build stage
FROM node:18-alpine AS build
WORKDIR /app
ENV NPM_CONFIG_PRODUCTION=false
COPY project/package.json project/package-lock.json* ./project/
COPY project/ .
RUN cd project && npm ci && npm run build

# Serve stage
FROM caddy:2-alpine
COPY --from=build /app/project/dist /srv
EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
